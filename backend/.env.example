# SQLite database path. A relative path is relative to the backend folder.
DATABASE_URL=sqlite:///./social_pulse.db

# Optional source credentials. Bluesky and GDELT use public endpoints.
GNEWS_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_MAX_SEARCH_PAGES=1
YOUTUBE_SEARCH_INTERVAL_HOURS=6
SERPAPI_API_KEY=
SERPAPI_ENABLED=true
SERPAPI_MAX_RESULTS_PER_QUERY=10
# Searches beyond direct Tata STRIVE mentions for public learner and ecosystem signals.
# Results are stored as thematic search previews, not full platform posts/comments.
SERPAPI_THEMATIC_ENABLED=true
SERPAPI_THEMATIC_INTERVAL_HOURS=12
# Optional semicolon-separated overrides for the built-in learner/NGO discovery searches.
# SERPAPI_THEMATIC_QUERIES='site:linkedin.com/posts student upskilling India;site:linkedin.com/posts NGO employability skills India'
# Google Custom Search is optional; enable only for an eligible existing API account.
GOOGLE_SEARCH_ENABLED=false
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
GOOGLE_SEARCH_MAX_RESULTS_PER_QUERY=10
GOOGLE_SEARCH_DELAY_SECONDS=1
# Optional semicolon-separated Google queries. Defaults target supported social domains.
# GOOGLE_SEARCH_QUERIES="\"Tata STRIVE\" site:reddit.com;\"Tata STRIVE\" site:x.com"
# Optional semicolon-separated SerpApi queries. Defaults search multiple social domains.
# SERPAPI_QUERIES="\"Tata STRIVE\" site:reddit.com;#tatastrive site:instagram.com"

# Local Ollama runtime and required local models.
OLLAMA_URL=http://localhost:11434
CLASSIFIER_MODEL=phi3:3.8b
REPLY_MODEL=llama3.1:8b
BLUESKY_WINDOW_DAYS=30

# Comma-separated development/production frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
LOG_LEVEL=INFO
